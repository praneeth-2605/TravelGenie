# Required: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: web-search fallback for RAG — https://tavily.com
TAVILY_API_KEY=
# Optional: live forecasts — https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=

# Optional overrides
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_WRITER_MODEL=openai/gpt-oss-120b

# Accounts
# Optional: "Continue with Google" — create an OAuth Client ID (Web) at
# https://console.cloud.google.com/apis/credentials and add http://localhost:5173
# to "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=
# Optional: secret for signing login sessions (one is generated in storage/ if empty)
SECRET_KEY=
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# Production storage: PostgreSQL with pgvector (e.g. Neon). Leave empty to use
# local files in storage/ (SQLite + Chroma) during development.
DATABASE_URL=
